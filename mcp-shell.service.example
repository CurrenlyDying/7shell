[Unit]
Description=MCP shell-access server
After=network.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_GROUP
WorkingDirectory=/opt/mcp-shell-server
EnvironmentFile=/opt/mcp-shell-server/.env
ExecStart=/opt/mcp-shell-server/.venv/bin/python /opt/mcp-shell-server/server.py
Restart=on-failure
RestartSec=3

# Damage limitation. None of this stops the shell tool running commands; it only
# narrows what the server process itself can reach.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/mcp-shell-server/data /opt/mcp-shell-server/audit.log
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallFilter=@system-service

# Set explicitly, and it matters which value.
#
# MCP_EXEC_USER runs commands as a second, weaker account by way of sudo, and
# sudo needs a setuid transition that NoNewPrivileges=yes forbids. No sudoers
# rule can grant it back. Several of the directives above enable
# NoNewPrivileges implicitly for a service that is not root, so leaving this
# line out is not the same as setting it to no. Stating it wins over the
# implication.
#
# The cost of "no" is real: this process may gain privileges through setuid
# binaries. That is the mechanism MCP_EXEC_USER depends on. In exchange,
# commands stop running as the account that owns the auth database and this
# code, which is the larger of the two risks.
#
# If you are NOT using MCP_EXEC_USER, change this to yes and lose nothing.
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
