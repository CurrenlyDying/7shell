# Public HTTPS URL this server is reached at (used as the OAuth issuer, the
# WebAuthn RP id, and the allowed Host/Origin).
MCP_BASE_URL=https://mcp.example.com

# Local bind. Keep on loopback and put a tunnel or reverse proxy in front.
HOST=127.0.0.1
PORT=8811

# REQUIRED. Comma-separated list of full callback URLs allowed to register a
# client. Matched exactly, not as prefixes, because a prefix of
# https://good.example would also accept https://good.example.attacker.com.
# Dynamic client registration is open by protocol, so without this anyone can
# register a client pointing at their own callback, send you its authorize link,
# and collect the code when you sign in on your own real domain. Holding the key
# proves who you are, not who you are granting to. Leave unset and every
# registration is refused.
MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback

# Deprecated former name for the setting above, still read if the new one is
# unset. Its values are matched exactly now, not as prefixes, so a setting that
# relied on prefix behaviour will stop matching. Rename it.
#MCP_ALLOWED_REDIRECT_PREFIXES=

# The -I principal that ssh-keygen -Y verify checks your signature against.
# Must match the first field of the line you put in data/allowed_signers.
MCP_SIGNATURE_PRINCIPAL=mcp-user

# Identity shown and stored for passkey registration. Set before registering
# your first passkey; the user id is baked into the credential at that point.
MCP_WEBAUTHN_USER_ID=mcp-user
MCP_WEBAUTHN_USER_NAME=mcp-user

# Default working directory for run_command. Defaults to the running user's home.
#MCP_DEFAULT_CWD=/home/youruser

# Run commands as a different, less privileged user instead of as this service.
# Needs a passwordless sudoers rule. Strongly recommended: without it a command
# can rewrite the auth database, the trusted keys, and this code.
#MCP_EXEC_USER=mcp-exec

# Refuse to start rather than fall back to plaintext audit lines when
# data/log_recipient.pub is missing or invalid.
#MCP_REQUIRE_AUDIT_KEY=1

# How many commands may run at once. Each occupies a worker thread; further
# calls queue rather than blocking the server.
#MCP_MAX_CONCURRENT_COMMANDS=8

# Cap on the body of any request, applied to the SDK's own routes as well as
# this server's. Counted as bytes arrive, not read from Content-Length.
#MCP_MAX_REQUEST_BYTES=1048576
